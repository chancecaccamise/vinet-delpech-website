# Enquiry-form delivery. Without RESEND_API_KEY the form does not send:
# in development the enquiry is logged to the server console, and in
# production the visitor is shown the direct email address instead.
#
# Copy to .env.local and fill in before go-live.

# Resend API key. Required for the contact form to deliver anything.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to siteConfig.email if unset.
CONTACT_TO_EMAIL=

# Verified Resend sender. Must be on a domain verified in Resend — the apex
# domain, not a www. subdomain. Strongly recommended to set explicitly.
CONTACT_FROM_EMAIL=
